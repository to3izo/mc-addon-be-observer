{
  "name": "addon-template",
  "version": "0.1.0",
  "description": "Describe your Add-On here.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "init:addon": "node tools/init-addon.ts",
    "validate": "node tools/validate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "build": "node tools/build.ts",
    "package": "node tools/package.ts",
    "deploy": "node tools/deploy.ts",
    "dev": "node tools/dev.ts",
    "clean": "node tools/clean.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "version:set": "node tools/set-version.ts"
  },
  "devDependencies": {
    "@minecraft/server": "2.10.0",
    "@minecraft/server-ui": "2.2.0",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2"
  }
}
